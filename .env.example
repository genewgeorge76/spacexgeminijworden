# ── Ops backend ───────────────────────────────────────────────────────────────
# VITE_API_BASE_URL: origin of the FastAPI ops backend (Fly.io).
# Lead capture, the contact form, and live Google reviews all POST/GET here.
# Leave empty ONLY when the SPA is served behind a proxy that forwards /api.
# Set this in the hosting provider's environment variables (Vercel → Settings →
# Environment Variables), not in a committed file.
VITE_API_BASE_URL="https://api.example.com"

# VITE_LEADS_API_URL: optional full-URL override for the lead endpoint.
# When set it takes precedence over VITE_API_BASE_URL for /contact submissions.
# Leave unset to use ${VITE_API_BASE_URL}/api/v1/leads/website.
# VITE_LEADS_API_URL=""

# ── Analytics ─────────────────────────────────────────────────────────────────
# VITE_GA4_MEASUREMENT_ID: GA4 property for conversion events.
VITE_GA4_MEASUREMENT_ID=""

# ── AI ────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY: Gemini API access.
#
# NOTE: do NOT add a VITE_ prefix to any provider key. Vite inlines VITE_*
# variables into the public client bundle at build time, which publishes the
# key to every visitor. Provider keys belong on the FastAPI backend only.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
